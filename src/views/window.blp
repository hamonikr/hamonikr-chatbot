using Gtk 4.0;
using Adw 1;

template $BavarderWindow : Adw.ApplicationWindow {

  title: _("HamoniKR Chatbot");
  default-width: 800;
  default-height: 600;
  width-request: 360;
  height-request: 200;

  ShortcutController {
    Shortcut {
      trigger: "<primary>q";
      action: "action(window.close)";
    }
  }



  Adw.ToastOverlay toast_overlay {
    Adw.NavigationSplitView split_view {
      max-sidebar-width: 260;
      sidebar-width-fraction: 0.38;
      sidebar: Adw.NavigationPage {
        title: _("Chatbot");
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-title: false;
            [start]
            MenuButton menu_button {
              primary: true;
              menu-model: main-menu;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
            }
            [end]
            Button new_chat {
              icon-name: "chat-message-new-symbolic";
              tooltip-text: _("New Chat");
              clicked => $on_new_chat_action();
            }
            Button clear_all_threads_button {
              icon-name: "user-trash-symbolic";
              tooltip-text: _("Clear All Threads");
              clicked => $on_clear_all_threads();
              styles ["flat"]
            }
            MenuButton theme_button {
              primary: false;
              icon-name: "weather-clear-night-symbolic";
              tooltip-text: _("Theme");
              menu-model: theme-menu;
            }
          }
          content: Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            child: Stack thread_stack {
              Gtk.ListBox threads_list {
                selection-mode: browse;
                show-separators: false;
                row-activated => $threads_row_activated_cb();
                styles ["navigation-sidebar"]
              }

              Adw.StatusPage status_no_chat_thread {
                title: _("No Chats");
                icon-name: "chat-bubbles-emtpy-symbolic";
              }

              Adw.StatusPage status_no_thread {
                icon-name: "org.hamonikr.Chatbot";
                description: _("Get started by creating a new chat or selecting one from the sidebar");
                hexpand: true;
                vexpand: true;

                child: Gtk.Box {
                  orientation: vertical;
                  spacing: 12;

                  Gtk.Button {
                    valign: center;
                    halign: center;
                    clicked => $on_new_chat_action();

                    Adw.ButtonContent {
                      icon-name: "chat-message-new-symbolic";
                      tooltip-text: _("New Chat");
                      label: _("New Chat");
                      use-underline: true;
                    }

                    styles [
                      "suggested-action",
                      "pill"
                    ]
                  }
                };
              }
            };
          };
        };
      };
      content: Adw.NavigationPage message_page {
        tag: "message";
        title: _("Message");
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [title]
            Adw.WindowTitle title {
              title: _("Chat");
            }

            // Button clear_all_button 제거

            [end]
            MenuButton provider_selector_button {
              icon-name: 'view-more-symbolic';
              tooltip-text: _("Select provider");
              visible: true;
            }

          }
          
          [top]
          Adw.Banner banner {

          }

          content: Overlay {
            [overlay]
            Button scroll_down_button {
              visible: false;
              styles [
                "circular",
                "image-button",
                "osd"
              ]
              icon-name: "go-bottom-symbolic";
              halign: end;
              valign: end;
              margin-bottom: 6;
              margin-end: 6;
              clicked => $scroll_down();
            }

            Stack stack {
              Adw.StatusPage status_no_chat {
                title: _("No Messages");
                description: _("Send first message to get started");
                icon-name: "chat-bubbles-emtpy-symbolic";
              }

              Adw.StatusPage status_no_internet {
                title: _("No Internet");
                icon-name: "network-offline-symbolic";
              }

              Adw.StatusPage status_no_thread_main {
                icon-name: "org.hamonikr.Chatbot";
                description: _("Get started by creating a new chat");
                hexpand: true;
                vexpand: true;

                child: Gtk.Box {
                  orientation: vertical;
                  spacing: 12;

                  Gtk.Button {
                    valign: center;
                    halign: center;
                    clicked => $on_new_chat_action();

                    Adw.ButtonContent {
                      icon-name: "chat-message-new-symbolic";
                      tooltip-text: _("New Chat");
                      label: _("New Chat");
                      use-underline: true;
                    }

                    styles [
                      "suggested-action",
                      "pill"
                    ]
                  }
                };
              }

              // Message List
              ScrolledWindow main {
                //vexpand: true;
                hscrollbar-policy: never;
                //edge-overshot => $handle_edge_reached() swapped;

                Adw.Clamp {
                //  vexpand: false;
                //  hexpand: true;
                  maximum-size: 1200;
                //  tightening-threshold: 550;
                //  margin-bottom: 4;
                //  margin-start: 12;
                //  margin-end: 12;

                  ListBox main_list {
                    margin-end: 5;
                    margin-start: 5;
                    styles [
                      "message-list",
                      "background"
                    ]
                    selection-mode: none;
                    show-separators: false;
                    hexpand: true;
                    vexpand: false;
                  }
                }
                    
                
              }
            }
            
          };

          [bottom]
          Gtk.Box toolbar {
            orientation: vertical;
            visible: true;

            Gtk.Box attached_file_box {
              orientation: horizontal;
              spacing: 8;
              margin-start: 18;
              margin-end: 18;
              margin-top: 8;
              margin-bottom: 8;
              visible: false;
              
              Gtk.Box file_info_box {
                orientation: horizontal;
                spacing: 10;
                hexpand: true;
                margin-start: 8;
                margin-end: 8;
                margin-top: 4;
                margin-bottom: 4;
                
                Gtk.Image file_icon {
                  icon-name: "document-symbolic";
                  icon-size: large;
                  margin-start: 4;
                  margin-end: 4;
                  valign: center;
                }
                
                Gtk.Label attached_file_label {
                  label: "";
                  hexpand: true;
                  halign: start;
                  valign: center;
                  ellipsize: end;
                  styles ["body"]
                }
              }
              
              Button remove_file_button {
                icon-name: "edit-delete-symbolic";
                tooltip-text: _("Remove file");
                clicked => $on_remove_file();
                valign: center;
                styles ["circular", "flat"]
              }
              
              styles ["card", "background"]
            }

            Gtk.Box toolbar_box {
              orientation: horizontal;

              Button file_upload_button {
                valign: end;
                icon-name: "document-open-symbolic";
                tooltip-text: _("Attach File");
                halign: start;
                margin-start: 6;
                margin-end: 6;
                margin-bottom: 6;
                clicked => $on_file_upload();
                styles ["circular"]
              }

              ScrolledWindow scrolled_window {
                vexpand: true;
                hexpand: true;
                vscrollbar-policy: external;
                max-content-height: 200;
                propagate-natural-height: true;
              }

              Button ask_button {
                valign: end;
                icon-name: "paper-plane-symbolic";
                tooltip-text: _("Ask");
                halign: end;
                clicked => $on_ask();
                styles ["suggested-action", "circular"]
              }
            }

            styles ["small-pill", "toolbar" ]
          }



        };
      };
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 400sp")
    setters {
      split_view.collapsed: true;

    }
  }

  Adw.Breakpoint {
    condition ("max-width: 500sp")
    apply => $mobile_mode_apply();
    unapply => $mobile_mode_unapply();
    setters {
      split_view.sidebar-width-fraction: 0.33;
      split_view.collapsed: true;
    }
  }


}

menu main-menu {
  item {
    label: _("Preferences");
    action: "app.preferences";
  }

  item {
    label: _("Keyboard Shortcuts");
    action: "win.show-help-overlay";
  }

  item {
    label: _("About HamoniKR Chatbot");
    action: "app.about";
  }
}

menu theme-menu {
  section {
    item {
      label: _("Light Theme");
      action: "app.set_color_scheme";
      target: "light";
    }
    item {
      label: _("Dark Theme");
      action: "app.set_color_scheme";
      target: "dark";
    }
  }
}
