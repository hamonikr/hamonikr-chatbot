#!/bin/bash

# HamoniKR Chatbot Launcher - Simplified Version
set -e

# Configuration
PKGDATA_DIR="@PKGDATA_DIR@"
LOCALEDIR="@LOCALE_DIR@"
VERSION="@VERSION@"

# Check GTK dependencies
if ! python3 -c "import gi; gi.require_version('Gtk', '4.0'); gi.require_version('Adw', '1')" 2>/dev/null; then
    echo "[ERROR] GTK dependencies not available. Please install:"
    echo "  sudo apt install python3-gi python3-gi-cairo gir1.2-gtk-4.0 gir1.2-adw-1"
    exit 1
fi

# Check OpenAI
if ! python3 -c "import openai" 2>/dev/null; then
    echo "[INFO] Installing OpenAI package..."
    pip3 install --user --break-system-packages "openai>=1.12.0,<2.0.0" 2>/dev/null || {
        echo "[WARNING] Could not install OpenAI. Manual installation may be required."
    }
fi

# Set environment
export PYTHONPATH="${PKGDATA_DIR}:${PYTHONPATH:-}"
export VERSION="${VERSION}"
export PKGDATA_DIR="${PKGDATA_DIR}"
export LOCALE_DIR="${LOCALEDIR}"

# Run the application
python3 << 'EOF'
import os
import sys
import signal
import locale
import gettext
import gi

VERSION = os.environ.get('VERSION')
pkgdatadir = os.environ.get('PKGDATA_DIR')
localedir = os.environ.get('LOCALE_DIR')

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('hamonikr-chatbot', localedir)
locale.textdomain('hamonikr-chatbot')
gettext.install('hamonikr-chatbot', localedir)

# Load GResource
from gi.repository import Gio
gresource_path = os.path.join(pkgdatadir, 'hamonikr-chatbot.gresource')
if os.path.exists(gresource_path):
    print(f"Loading GResource: {gresource_path}", file=sys.stderr)
    resource = Gio.Resource.load(gresource_path)
    resource._register()
    print("GResource loaded successfully", file=sys.stderr)
else:
    # For development, try to find gresource in different locations
    possible_paths = [
        '/usr/share/hamonikr-chatbot/hamonikr-chatbot.gresource'
    ]
    for path in possible_paths:
        if os.path.exists(path):
            print(f"Loading GResource from: {path}", file=sys.stderr)
            resource = Gio.Resource.load(path)
            resource._register()
            print("GResource loaded successfully", file=sys.stderr)
            break

# Import and run main
try:
    from hamonikr_chatbot import main
    sys.exit(main.main(VERSION))
except ImportError as e:
    print(f"Error importing hamonikr_chatbot module: {e}", file=sys.stderr)
    print(f"PYTHONPATH: {sys.path}", file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f"Error running application: {e}", file=sys.stderr)
    import traceback
    traceback.print_exc()
    sys.exit(1)
EOF